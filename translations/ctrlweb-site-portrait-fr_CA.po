#. translators: 1: what failed, 2: HTTP status code, 3: error details from the
#. service.
#: includes/class-service-client.php:249
msgid "%1$s failed (HTTP %2$d). %3$s"
msgstr "%1$s a échoué (HTTP %2$d). %3$s"

#. translators: %s: error message.
#: includes/class-service-client.php:218
msgid "Could not reach the service: %s"
msgstr "Impossible de joindre le service : %s"

#: includes/class-service-client.php:182
msgid "The service address must use HTTPS."
msgstr "L’adresse du service doit utiliser HTTPS."

#: includes/class-service-client.php:77
msgid "The service does not support version 1 of the Site Portrait protocol."
msgstr "Le service ne prend pas en charge la version 1 du protocole Site Portrait."

#. translators: %s: name of the invalid member, e.g. token_endpoint.
#: includes/class-service-client.php:69
msgid "The service discovery document is invalid (%s)."
msgstr "Le document de découverte du service est invalide (%s)."

#: includes/class-service-client.php:52
msgid "The service discovery document is not valid JSON."
msgstr "Le document de découverte du service n’est pas un JSON valide."

#. translators: %d: HTTP status code.
#: includes/class-service-client.php:47
msgid "The service did not publish a Site Portrait discovery document (HTTP status %d)."
msgstr "Le service n’a pas publié de document de découverte Site Portrait (code HTTP %d)."

#: includes/class-service-client.php:36
msgid "Enter the HTTPS address of the service, for example https://service.example."
msgstr "Saisissez l’adresse HTTPS du service, par exemple https://service.example."

#: includes/class-scopes.php:83
msgid "Number of users per role. Never names, logins or email addresses."
msgstr "Nombre d’utilisateurs par rôle. Jamais de noms, d’identifiants de connexion ni d’adresses de courriel."

#: includes/class-scopes.php:82
msgid "User counts"
msgstr "Nombre d’utilisateurs"

#: includes/class-scopes.php:79
msgid "Number of posts per type and status, media files, taxonomy terms and comments; size of the uploads, plugins and themes folders. Counts only, never content."
msgstr "Nombre de publications par type et par état, de fichiers médias, de termes de taxonomie et de commentaires; taille des dossiers uploads, plugins et themes. Des nombres seulement, jamais de contenu."

#: includes/class-scopes.php:78
msgid "Content volumes"
msgstr "Volume de contenu"

#: includes/class-scopes.php:75
msgid "Database engine and version, total size, number of tables, largest tables, autoloaded options size. No credentials or table prefix."
msgstr "Moteur et version de la base de données, taille totale, nombre de tables, plus grosses tables, taille des options chargées automatiquement. Ni identifiants d’accès ni préfixe des tables."

#: includes/class-scopes.php:74
msgid "Database"
msgstr "Base de données"

#: includes/class-scopes.php:71
msgid "Operating system family, web server, PHP version, extensions and limits, OPcache, CPU count, memory and disk space. No host names, IP addresses or paths."
msgstr "Famille du système d’exploitation, serveur web, version, extensions et limites de PHP, OPcache, nombre de processeurs, mémoire et espace disque. Ni noms d’hôte, ni adresses IP, ni chemins d’accès."

#: includes/class-scopes.php:70
msgid "Server"
msgstr "Serveur"

#: includes/class-scopes.php:67
msgid "Installed themes with version, active and parent theme, available update."
msgstr "Thèmes installés avec leur version, thème actif et thème parent, mise à jour disponible."

#: includes/class-scopes.php:66
msgid "Themes"
msgstr "Thèmes"

#: includes/class-scopes.php:63
msgid "Installed plugins with version, status and available update; must-use plugins and drop-ins."
msgstr "Extensions installées avec leur version, leur état et la mise à jour disponible; extensions indispensables (must-use) et drop-ins."

#: includes/class-scopes.php:62
msgid "Plugins"
msgstr "Extensions"

#: includes/class-scopes.php:59
msgid "WordPress version and available update, languages, multisite summary, environment type, HTTPS, permalink type, debug flags, cron health, object and page cache detection."
msgstr "Version de WordPress et mise à jour disponible, langues, résumé du multisite, type d’environnement, HTTPS, type de permaliens, indicateurs de débogage, état du cron, détection des caches d’objets et de pages."

#: includes/class-scopes.php:58
msgid "WordPress core"
msgstr "Cœur de WordPress"

#: includes/class-pairing.php:460
msgid "Notifying the service"
msgstr "La notification du service"

#: includes/class-pairing.php:210
msgid "The service returned keys that do not match its discovery document."
msgstr "Le service a renvoyé des clés qui ne correspondent pas à son document de découverte."

#: includes/class-pairing.php:199
msgid "The service returned an invalid response (scopes)."
msgstr "Le service a renvoyé une réponse invalide (scopes)."

#: includes/class-pairing.php:194
msgid "The service returned an invalid response (pairing_id)."
msgstr "Le service a renvoyé une réponse invalide (pairing_id)."

#: includes/class-pairing.php:189
msgid "The code exchange with the service"
msgstr "L’échange du code avec le service"

#: includes/class-pairing.php:155
msgid "This site is already connected to a service. Disconnect it first."
msgstr "Ce site est déjà connecté à un service. Déconnectez-le d’abord."

#: includes/class-pairing.php:152
msgid "The service returned an invalid authorization code."
msgstr "Le service a renvoyé un code d’autorisation invalide."

#: includes/class-pairing.php:149
msgid "The connection request expired or was not started from this site. Please start again."
msgstr "La demande de connexion a expiré ou n’a pas été lancée depuis ce site. Veuillez recommencer."

#: includes/class-pairing.php:74
msgid "Select at least one category of data to share."
msgstr "Sélectionnez au moins une catégorie de données à partager."

#: includes/admin/class-settings-page.php:532
msgid "You are not allowed to manage Site Portrait."
msgstr "Vous n’avez pas l’autorisation de gérer Site Portrait."

#: includes/admin/class-settings-page.php:469
msgid "Result"
msgstr "Résultat"

#: includes/admin/class-settings-page.php:468
msgid "Data categories"
msgstr "Catégories de données"

#: includes/admin/class-settings-page.php:467
msgid "Request"
msgstr "Requête"

#: includes/admin/class-settings-page.php:466
msgid "IP address"
msgstr "Adresse IP"

#: includes/admin/class-settings-page.php:465
msgid "Date"
msgstr "Date"

#: includes/admin/class-settings-page.php:461
msgid "Requests received on the Site Portrait API during the last 90 days."
msgstr "Requêtes reçues par l’API Site Portrait au cours des 90 derniers jours."

#: includes/admin/class-settings-page.php:460
msgid "Access log"
msgstr "Journal des accès"

#: includes/admin/class-settings-page.php:441
msgid "Disconnect this site from the service?"
msgstr "Déconnecter ce site du service?"

#: includes/admin/class-settings-page.php:440
msgid "Disconnecting takes effect immediately: the service can no longer read anything, and its key is deleted from this site. The service is then notified."
msgstr "La déconnexion prend effet immédiatement : le service ne peut plus rien lire et sa clé est supprimée de ce site. Le service en est ensuite informé."

#: includes/admin/class-settings-page.php:439
#: includes/admin/class-settings-page.php:443
msgid "Disconnect"
msgstr "Déconnecter"

#: includes/admin/class-settings-page.php:436
msgid "Generate a new site key"
msgstr "Générer une nouvelle clé du site"

#. translators: %s: comma-separated key identifiers.
#: includes/admin/class-settings-page.php:431
msgid "Trusted service keys: %s"
msgstr "Clés du service approuvées : %s"

#. translators: %s: key identifier.
#: includes/admin/class-settings-page.php:426
msgid "Site key: %s"
msgstr "Clé du site : %s"

#: includes/admin/class-settings-page.php:422
msgid "Keys"
msgstr "Clés"

#: includes/admin/class-settings-page.php:416
msgid "Optional. One IP address or CIDR range per line (IPv4 or IPv6). When set, requests from other addresses are refused."
msgstr "Facultatif. Une adresse IP ou une plage CIDR par ligne (IPv4 ou IPv6). Si la liste est remplie, les requêtes provenant d’autres adresses sont refusées."

#: includes/admin/class-settings-page.php:414
msgid "Allowed IP addresses"
msgstr "Adresses IP autorisées"

#: includes/admin/class-settings-page.php:394
msgid "Pairing ID"
msgstr "Identifiant de jumelage"

#: includes/admin/class-settings-page.php:389
msgid "waiting for the service to confirm"
msgstr "en attente de confirmation par le service"

#: includes/admin/class-settings-page.php:385
msgid "Connected on"
msgstr "Connecté le"

#: includes/admin/class-settings-page.php:380
msgid "Account"
msgstr "Compte"

#: includes/admin/class-settings-page.php:369
msgid "Connected service"
msgstr "Service connecté"

#: includes/admin/class-settings-page.php:353
msgid "Cancel"
msgstr "Annuler"

#: includes/admin/class-settings-page.php:349
msgid "Connect"
msgstr "Connecter"

#: includes/admin/class-settings-page.php:348
msgid "Clicking Connect sends you to the service to sign in and approve. The service then receives this site’s address and a public key, and this site stores the service’s public key."
msgstr "En cliquant sur Connecter, vous êtes redirigé vers le service pour vous identifier et approuver. Le service reçoit alors l’adresse de ce site et une clé publique, et ce site enregistre la clé publique du service."

#: includes/admin/class-settings-page.php:346
msgid "Network mode: the service will also be able to list the addresses of all sites of this network, and their counts for the categories you tick."
msgstr "Mode réseau : le service pourra aussi lister les adresses de tous les sites de ce réseau, ainsi que leurs nombres pour les catégories cochées."

#. translators: %s: justification provided by the service.
#: includes/admin/class-settings-page.php:338
msgid "Why the service asks: %s"
msgstr "Pourquoi le service le demande : %s"

#: includes/admin/class-settings-page.php:325
msgid "The service can only read the categories you tick. It can never change anything on this site. You can change this choice or disconnect at any time."
msgstr "Le service ne peut lire que les catégories que vous cochez. Il ne peut jamais rien modifier sur ce site. Vous pouvez changer ce choix ou vous déconnecter à tout moment."

#: includes/admin/class-settings-page.php:324
#: includes/admin/class-settings-page.php:401
msgid "Data the service may read"
msgstr "Données que le service peut lire"

#: includes/admin/class-settings-page.php:313
msgid "Terms of use"
msgstr "Conditions d’utilisation"

#: includes/admin/class-settings-page.php:311
#: includes/admin/class-settings-page.php:375
msgid "Privacy policy"
msgstr "Politique de confidentialité"

#: includes/admin/class-settings-page.php:309
msgid "Privacy"
msgstr "Confidentialité"

#: includes/admin/class-settings-page.php:300
#: includes/admin/class-settings-page.php:372
msgid "Service"
msgstr "Service"

#. translators: %s: service name.
#: includes/admin/class-settings-page.php:295
msgid "Connect to %s?"
msgstr "Connecter ce site à %s?"

#: includes/admin/class-settings-page.php:279
msgid "Look up service"
msgstr "Rechercher le service"

#: includes/admin/class-settings-page.php:275
msgid "Provided by the service. This site will read the service description at this address and show it to you before anything else happens."
msgstr "Fournie par le service. Ce site lira la description du service à cette adresse et vous l’affichera avant toute autre action."

#: includes/admin/class-settings-page.php:272
msgid "Service address"
msgstr "Adresse du service"

#: includes/admin/class-settings-page.php:267
msgid "Site Portrait lets a service you choose (for example a hosting provider) read a technical description of this site to recommend suitable hosting. It is disabled until you connect a service, and nothing is sent anywhere before you confirm."
msgstr "Site Portrait permet à un service de votre choix (par exemple un hébergeur) de lire une description technique de ce site afin de recommander un hébergement adapté. L’extension reste inactive tant que vous n’avez pas connecté de service, et rien n’est envoyé nulle part avant votre confirmation."

#: includes/admin/class-settings-page.php:245
msgid "Development mode is active (SITE_PORTRAIT_DEV_MODE): unencrypted HTTP and local addresses are accepted. Never use this on a production site."
msgstr "Le mode développement est actif (SITE_PORTRAIT_DEV_MODE) : le HTTP non chiffré et les adresses locales sont acceptés. Ne l’utilisez jamais sur un site en production."

#: includes/admin/class-settings-page.php:220
msgid "The site is disconnected and the service was notified."
msgstr "Le site est déconnecté et le service en a été informé."

#. translators: %s: error message.
#: includes/admin/class-settings-page.php:217
msgid "The site is disconnected and the service can no longer read any data. However the service could not be notified: %s"
msgstr "Le site est déconnecté et le service ne peut plus lire aucune donnée. Toutefois, le service n’a pas pu être informé : %s"

#: includes/admin/class-settings-page.php:204
msgid "A new site key was generated. The service will pick it up automatically."
msgstr "Une nouvelle clé du site a été générée. Le service la prendra en compte automatiquement."

#: includes/admin/class-settings-page.php:195
msgid "Settings saved."
msgstr "Réglages enregistrés."

#. translators: %s: comma-separated list of invalid entries.
#: includes/admin/class-settings-page.php:192
msgid "Settings saved, but these allow-list entries were ignored because they are not valid IP addresses or ranges: %s"
msgstr "Réglages enregistrés, mais ces entrées de la liste d’adresses autorisées ont été ignorées, car ce ne sont pas des adresses ou des plages IP valides : %s"

#: includes/admin/class-settings-page.php:168
msgid "The site is now connected. The service can read the data categories you selected."
msgstr "Le site est maintenant connecté. Le service peut lire les catégories de données que vous avez sélectionnées."

#. translators: %s: error code returned by the service.
#: includes/admin/class-settings-page.php:158
msgid "The service returned an error: %s"
msgstr "Le service a renvoyé une erreur : %s"

#: includes/admin/class-settings-page.php:156
msgid "The connection was declined on the service side."
msgstr "La connexion a été refusée du côté du service."

#: includes/admin/class-settings-page.php:147
msgid "The link you followed has expired or you are not allowed to connect this site."
msgstr "Le lien que vous avez suivi a expiré, ou vous n’avez pas l’autorisation de connecter ce site."

#: includes/admin/class-settings-page.php:110
msgid "The service information expired. Please look up the service again."
msgstr "Les informations du service ont expiré. Veuillez rechercher le service de nouveau."

#: includes/admin/class-settings-page.php:79
msgid "Site Portrait describes the whole server and database, so on a multisite network it must be network-activated by a super admin. It does nothing while activated on a single site; deactivate it here and network-activate it from the Network Admin."
msgstr "Site Portrait décrit l’ensemble du serveur et de la base de données. Sur un réseau multisite, l’extension doit donc être activée sur le réseau par un super administrateur. Activée sur un seul site, elle ne fait rien : désactivez-la ici, puis activez-la sur le réseau depuis l’administration du réseau."

#: includes/admin/class-settings-page.php:66
msgid "Settings"
msgstr "Réglages"

#: includes/admin/class-settings-page.php:51
msgid "Site Portrait"
msgstr "Site Portrait"

