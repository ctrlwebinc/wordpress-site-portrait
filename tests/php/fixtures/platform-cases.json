    "facts": { "root": null, "packages": {}, "classes": { "wp_config": false, "acorn": false }, "wp_env": false, "layout": { "core_dir": "html", "content_dir": "wp-content", "docroot": "www", "siblings": false }, "acorn_root_boot": null },
